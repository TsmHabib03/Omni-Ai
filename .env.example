# Server-only secrets. Copy this file to .env.local, then add your own keys.
# Do not prefix secrets with VITE_ or NEXT_PUBLIC_.
GROQ_API_KEY=
PIX_ROUTER_API_KEY=
# Documented image endpoint. Model IDs come from GET /v1/models for your account.
PIX_ROUTER_IMAGE_ENDPOINT=https://pixrouter.com/v1/images/generations
PIX_ROUTER_IMAGE_MODEL=midjourney/midjourney-v7
API_PORT=8787
SHOW_CARBON_WARNING=false
# OAuth is read from ignored .env.local or the process environment for deployment.
GOOGLE_CLIENT_ID=
# Public Google client ID and gateway URL for authenticated local development.
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=
# Optional HTTPS legal destinations; leave blank until published.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
# Retire local provider routes when using the Cloudflare gateway.
DISABLE_LOCAL_GENERATION=false
