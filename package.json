{
  "name": "omni-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.mjs",
    "test": "node --test tests/environmental-impact.test.mjs tests/private-files.test.mjs tests/secret-audit.test.mjs tests/local-secrets.test.mjs && node verify.mjs && node verify-api.mjs && node verify-auth.mjs",
    "test:carbon": "playwright test carbon-warning",
    "build:extension": "node scripts/build-extension.mjs",
    "test:worker": "npm --prefix omni-rate-limit test",
    "dev:worker": "npm --prefix omni-rate-limit run dev",
    "deploy:cloudflare": "npm --prefix omni-rate-limit run deploy",
    "test:layout": "playwright test cinematic-layout",
    "test:security-browser": "playwright test --config playwright.security.config.js",
    "audit:secrets": "node scripts/security-scan.mjs",
    "postbuild": "node scripts/security-scan.mjs",
    "security:hooks": "git config --local core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
