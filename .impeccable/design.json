  "components": [
    {
      "name": "Secondary action · dark",
      "kind": "button",
      "refersTo": "button-secondary-dark",
      "description": "Quiet action in a dark account dialog.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Sign out</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 16px;border:1px solid #b7aad31c;background:#b7aad306;border-radius:12px;font:400 15px 'DM Sans',system-ui,sans-serif;color:#bab8cb;cursor:pointer;transition:background .2s,border-color .2s,color .2s,transform .2s}.ds-secondary:hover{background:#b7aad312;border-color:#b7aad338;color:#e0d9ef}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:focus-visible,.ds-generate:focus-visible,.ds-avatar:focus-visible,.ds-nav button:focus-visible,.ds-mode:focus-visible{outline:2px solid #b3a0d9;outline-offset:4px}"
    },
    {
      "name": "Secondary action · pearl",
      "kind": "button",
      "refersTo": "button-secondary-light",
      "description": "The same action in the light workspace appearance.",
      "html": "<button class=\"ds-secondary ds-secondary-light\" type=\"button\">New chat</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 16px;border:1px solid #b7aad31c;background:#b7aad306;border-radius:12px;font:400 15px 'DM Sans',system-ui,sans-serif;color:#bab8cb;cursor:pointer;transition:background .2s,border-color .2s,color .2s,transform .2s}.ds-secondary:hover{background:#b7aad312;border-color:#b7aad338;color:#e0d9ef}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:focus-visible,.ds-generate:focus-visible,.ds-avatar:focus-visible,.ds-nav button:focus-visible,.ds-mode:focus-visible{outline:2px solid #b3a0d9;outline-offset:4px}.ds-secondary-light{background:#ffffff70;border-color:#80609529;color:#69517c}.ds-secondary-light:hover{background:#e9e0f37a;border-color:#8060954a;color:#52366d}"
    },
    {
      "name": "Generate",
      "kind": "button",
      "refersTo": "button-generate-dark",
      "description": "Primary generation action; disable while admission or generation is pending.",
      "html": "<button class=\"ds-generate\" type=\"button\">Generate <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-generate{display:inline-flex;align-items:center;gap:9px;min-height:46px;padding:11px 16px;border:1px solid #bdabd33a;border-radius:12px;background:linear-gradient(125deg,#574568c9,#38374ed9);color:#d5c9e5;font:500 16px 'DM Sans',system-ui,sans-serif;cursor:pointer;transition:background .2s,transform .2s}.ds-generate:hover:not(:disabled){background:linear-gradient(125deg,#67517bc9,#44415ed9);border-color:#cbb5e163}.ds-generate:active{transform:translateY(1px)}.ds-generate:disabled{opacity:.6;cursor:default}.ds-secondary:focus-visible,.ds-generate:focus-visible,.ds-avatar:focus-visible,.ds-nav button:focus-visible,.ds-mode:focus-visible{outline:2px solid #b3a0d9;outline-offset:4px}"
    },
    {
      "name": "Account avatar",
      "kind": "button",
      "refersTo": "button-avatar",
      "description": "Circular fallback for the bottom-navigation account photo.",
      "html": "<button class=\"ds-avatar\" type=\"button\" aria-label=\"Manage account\" aria-haspopup=\"dialog\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.5\"/><path d=\"M4.5 21v-2a7.5 7.5 0 0 1 15 0v2\"/></svg></span></button>",
      "css": ".ds-avatar{display:grid;place-items:center;width:44px;height:44px;padding:4px;border:0;border-radius:50%;background:transparent;cursor:pointer;transition:background .2s,transform .2s}.ds-avatar span{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#3b304c;color:#e0d2ef}.ds-avatar:hover{background:#b7aad31c}.ds-avatar:hover span{filter:brightness(1.12)}.ds-avatar:active{transform:translateY(1px)}.ds-secondary:focus-visible,.ds-generate:focus-visible,.ds-avatar:focus-visible,.ds-nav button:focus-visible,.ds-mode:focus-visible{outline:2px solid #b3a0d9;outline-offset:4px}"
    },
    {
      "name": "Generation mode",
