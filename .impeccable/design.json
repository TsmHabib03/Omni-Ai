      "refersTo": "mode-field",
      "description": "Compact mode selector beside the composer.",
      "html": "<label class=\"ds-mode-label\">Generation mode <select class=\"ds-mode\" aria-label=\"Generation mode\"><option>Text</option><option>Image</option></select></label>",
      "css": ".ds-mode-label{display:flex;align-items:center;gap:10px;font:400 13px 'DM Sans',system-ui,sans-serif;color:#b3a5c6}.ds-mode{min-height:36px;font:400 13px 'DM Sans',system-ui,sans-serif;background:#b7aad306;border:1px solid #b7aad31c;border-radius:8px;padding:5px 26px 5px 10px;color:#b3a5c6;cursor:pointer}.ds-mode option{background:#16131e;color:#c9bfd8}.ds-mode:hover{border-color:#b7aad351}.ds-secondary:focus-visible,.ds-generate:focus-visible,.ds-avatar:focus-visible,.ds-nav button:focus-visible,.ds-mode:focus-visible{outline:2px solid #b3a0d9;outline-offset:4px}"
    },
    {
      "name": "Bottom navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Compact active-tab treatment in the fixed bottom dock.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button type=\"button\" aria-current=\"page\">Chat</button><button type=\"button\">Create</button><button type=\"button\">Library</button><button type=\"button\">History</button><button class=\"ds-nav-profile\" type=\"button\" aria-label=\"Manage account\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.5\"/><path d=\"M4.5 21v-2a7.5 7.5 0 0 1 15 0v2\"/></svg></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:5px;width:max-content;max-width:100%;padding:6px 9px;border:1px solid #b7aad318;border-radius:18px;background:#11131de8;backdrop-filter:blur(24px);box-shadow:0 12px 40px #0005,inset 0 1px 0 #ffffff04}.ds-nav button{min-height:48px;padding:0 21px;border:1px solid transparent;border-radius:12px;background:none;font:400 15px 'DM Sans',system-ui,sans-serif;color:#8d849f;cursor:pointer;transition:background .2s,transform .2s}.ds-nav button[aria-current]{background:linear-gradient(115deg,#8c73ad18,#908daa0a);border-color:#b7aad323;color:#c8badc}.ds-nav button:hover{background:#b7aad308;color:#e0d9ef}.ds-nav button:active{transform:translateY(1px)}.ds-nav .ds-nav-profile{display:grid;place-items:center;width:44px;min-height:44px;padding:4px;border-radius:50%;background:#3b304c;color:#e0d2ef}@media(max-width:600px){.ds-nav{width:100%;padding:5px;gap:3px;border-radius:15px}.ds-nav button{flex:1;padding:4px;font-size:11px;min-height:52px}.ds-nav .ds-nav-profile{flex:none}}.ds-secondary:focus-visible,.ds-generate:focus-visible,.ds-avatar:focus-visible,.ds-nav button:focus-visible,.ds-mode:focus-visible{outline:2px solid #b3a0d9;outline-offset:4px}"
    },
